package(
    default_visibility = [
        "//visibility:public",
    ],
)


load("//build/bazel_mgk_rules:mgk.bzl", "define_mgk")
load(
    "//build/kernel/kleaf:kernel.bzl",
    "kernel_build",
    "kernel_images",
    "kernel_module",
    "kernel_modules_install",
)
load("//build/kernel/kleaf:constants.bzl", "DEFAULT_GKI_OUTS")

mgk_kmi_symbol_list = "//kernel-6.6:android/abi_gki_aarch64_mtk"

filegroup(
        name = "mgk_configs",
        srcs = glob([
            "arch/arm64/configs/*",
            "kernel/configs/**",
            "**/Kconfig",
            "drivers/cpufreq/Kconfig.*",
        ]) + [
            "Kconfig.ext",
            # FIXME
            "Makefile.ext",
            "certs/mtk_signing_key.pem",
        ],
)
filegroup(
        name = "mgk_dt-bindings",
        srcs = glob([
            "include/dt-bindings/**",
            "include/dtc/**",
        ]),
)

# mgk_64_k66
load("//kernel_device_modules-6.6:kernel/kleaf/mgk_64.bzl",
     "mgk_64_defconfig",
     "mgk_64_kleaf_modules",
     "mgk_64_kleaf_eng_modules",
     "mgk_64_kleaf_userdebug_modules",
     "mgk_64_kleaf_user_modules",
     "mgk_64_common_modules",
     "mgk_64_common_eng_modules",
     "mgk_64_common_userdebug_modules",
     "mgk_64_common_user_modules",
     "mgk_64_device_modules",
     "mgk_64_platform_device_modules",
     "mgk_64_device_eng_modules",
     "mgk_64_platform_device_eng_modules",
     "mgk_64_device_userdebug_modules",
     "mgk_64_platform_device_userdebug_modules",
     "mgk_64_device_user_modules",
     "mgk_64_platform_device_user_modules"
)

define_mgk(
    name = "mgk_64_k66",
    clang_autofdo_profile = "@dash_kernel_profiles//:aarch64/android15-6.6/kernel.afdo",
    defconfig = mgk_64_defconfig,
    kleaf_modules = mgk_64_kleaf_modules,
    kleaf_eng_modules = mgk_64_kleaf_eng_modules,
    kleaf_userdebug_modules = mgk_64_kleaf_userdebug_modules,
    kleaf_user_modules = mgk_64_kleaf_user_modules,
    common_modules = mgk_64_common_modules,
    common_eng_modules = mgk_64_common_eng_modules,
    common_userdebug_modules = mgk_64_common_userdebug_modules,
    common_user_modules = mgk_64_common_user_modules,
    device_modules = mgk_64_device_modules,
    platform_device_modules = mgk_64_platform_device_modules,
    device_eng_modules = mgk_64_device_eng_modules,
    platform_device_eng_modules = mgk_64_platform_device_eng_modules,
    device_userdebug_modules = mgk_64_device_userdebug_modules,
    platform_device_userdebug_modules = mgk_64_platform_device_userdebug_modules,
    device_user_modules = mgk_64_device_user_modules,
    platform_device_user_modules = mgk_64_platform_device_user_modules,
    symbol_list = mgk_kmi_symbol_list,
    strip_user_device_modules = True,
    # Kleaf's system_dlkm action re-signs the staged core modules.
    user_core_implicit_outs = [
        "scripts/sign-file",
        "certs/signing_key.pem",
        "certs/signing_key.x509",
    ],
    user_defconfig_fragments = ["kernel/configs/tls.config"],
    user_gki_modules = ["net/tls/tls.ko"],
    dtb_files = ["mediatek/dash.dtb"],
)

kernel_build(
    name = "kernel_strict.user",
    srcs = [
        "//kernel-6.6:kernel_aarch64_sources",
        ":mgk_configs",
    ],
    build_config = ":kernel_aarch64_mgk_64_k66_build_config.user",
    clang_autofdo_profile = "@dash_kernel_profiles//:aarch64/android15-6.6/kernel.afdo",
    defconfig_fragments = ["kernel/configs/tls.config"],
    make_goals = [
        "PAHOLE_FLAGS=--btf_gen_floats",
        "Image",
        "Image.lz4",
        "Image.gz",
        "modules",
        "dtbs",
    ],
    strip_modules = True,
    outs = DEFAULT_GKI_OUTS,
    module_implicit_outs = mgk_64_common_modules + ["net/tls/tls.ko"],
    kmi_symbol_list = "//kernel-6.6:android/abi_gki_aarch64",
    additional_kmi_symbol_lists = ["//kernel-6.6:aarch64_additional_kmi_symbol_lists"],
    protected_exports_list = "//kernel-6.6:android/abi_gki_protected_exports_aarch64",
    protected_modules_list = "//kernel-6.6:gki_aarch64_protected_modules",
    trim_nonlisted_kmi = True,
    kmi_symbol_list_strict_mode = True,
)

# Early bootstrap for strict custom and official cores.
kernel_module(
    name = "ufs_wlun_bootstrap_strict.user",
    srcs = ["//kernel_device_modules-6.6/drivers/ufs/wlun_bootstrap:sources"],
    makefile = ["//kernel_device_modules-6.6/drivers/ufs/wlun_bootstrap:Makefile"],
    outs = ["ufs_wlun_bootstrap.ko"],
    kernel_build = ":kernel_strict.user",
)

kernel_module(
    name = "ufs_wlun_bootstrap.user",
    srcs = ["//kernel_device_modules-6.6/drivers/ufs/wlun_bootstrap:sources"],
    makefile = ["//kernel_device_modules-6.6/drivers/ufs/wlun_bootstrap:Makefile"],
    outs = ["ufs_wlun_bootstrap.ko"],
    kernel_build = ":mgk_64_k66_kernel_aarch64.user",
)

# Package the signed core modules separately from the MTK device modules.
kernel_modules_install(
    name = "core_modules.user",
    kernel_build = ":mgk_64_k66_kernel_aarch64.user",
    kernel_modules = [],
)

kernel_images(
    name = "system_dlkm.user",
    kernel_build = ":mgk_64_k66_kernel_aarch64.user",
    kernel_modules_install = ":core_modules.user",
    build_system_dlkm = True,
    build_system_dlkm_flatten = True,
    system_dlkm_fs_types = ["erofs"],
    modules_list = "//kernel-6.6:gki_system_dlkm_modules_arm64",
)

# These consumers use the audited OS3.0.305 platform ABI. Keep the normal
# device-module build and its providers on their native source ABI.
kernel_module(
    name = "heap_refill_compat.user",
    srcs = [
        ":mgk_64_k66_sources",
        "//kernel_device_modules-6.6/drivers/dma-buf/heaps/platform-abi:sources",
    ],
    makefile = ["//kernel_device_modules-6.6/drivers/dma-buf/heaps/platform-abi:Makefile"],
    outs = ["mtk_heap_refill.ko"],
    kernel_build = ":mgk_64_k66.user",
    deps = [":mgk_64_k66_modules.user"],
)

kernel_module(
    name = "display_security_compat.user",
    srcs = [
        ":mgk_64_k66_sources",
        "//kernel_device_modules-6.6/drivers/dma-buf/heaps/platform-abi:build_rules",
        "//kernel_device_modules-6.6/drivers/gpu/drm/mediatek/mediatek_v2/platform-abi:sources",
    ],
    makefile = ["//kernel_device_modules-6.6/drivers/gpu/drm/mediatek/mediatek_v2/platform-abi:Makefile"],
    outs = ["mtk_disp_sec.ko"],
    kernel_build = ":mgk_64_k66.user",
    deps = [":mgk_64_k66_modules.user"],
)
